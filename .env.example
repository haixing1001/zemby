# Replace this with a unique password of at least 12 characters before starting.
CINEBASE_ADMIN_PASSWORD=

# Host port and host-side media folder. MEDIA_PATH is mounted read-only at /media.
CINEBASE_PORT=8097
CINEBASE_MAX_STREAMS=32
MEDIA_PATH=./media
TZ=Asia/Shanghai
PUID=1000
PGID=1000

# Set these only if you are pulling the published image from another registry path.
# GITHUB_REPOSITORY=haixing1001/cinebase
# IMAGE_TAG=codex
